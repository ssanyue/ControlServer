{
  "Server": {
    "Startup": {
      "AutoOpenBrowser": true
    },
    "Http": {
      "Port": 8899,
      "Urls": "http://0.0.0.0:8899"
    },
    "Listener": {
      "PairingPort": 9999
    },
    "Storage": {
      "DataDir": ""
    },
    "Auth": {
      "Mode": "Cookie",
      "DefaultAdminUserName": "admin",
      "DefaultAdminPassword": "admin123",
      "EnforcePasswordChange": true
    },
    "Security": {
      "AllowedCidrs": []
    },
    "License": {
      "Enforcement": "Warn",
      "AutoTrial": true,
      "TrialDays": 30,
      "RequireNetworkTime": false,
      "ClockToleranceSeconds": 120
    },
    "Time": {
      "NtpServers": [
        "ntp.aliyun.com",
        "ntp.tencent.com",
        "cn.pool.ntp.org"
      ]
    },
    "Logging": {
      "RetentionEnabled": true,
      "RetentionDays": 30,
      "RetentionMaxMegabytes": 200
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
