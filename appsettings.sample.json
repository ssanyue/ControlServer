{
  "Server": {
    "Startup": {
      "AutoOpenBrowser": true
    },
    "Http": {
      "Port": 8899
    },
    "Listener": {
      "PairingPort": 9999
    },
    "Storage": {
      "DataDir": ""
    },
    "Auth": {
      "Mode": "Cookie",
      "DefaultAdminUserName": "admin",
      "DefaultAdminPassword": "admin123",
      "LoginRateLimit": {
        "Enabled": true,
        "PermitLimit": 20,
        "WindowMinutes": 5
      }
    },
    "Security": {
      "AllowedCidrs": []
    },
    "Files": {
      "SessionExpiryHours": 24,
      "OrphanGraceHours": 24,
      "TaskRetentionDays": 30
    },
    "Time": {
      "NtpServers": [
        "ntp.aliyun.com",
        "ntp.tencent.com",
        "cn.pool.ntp.org"
      ]
    },
    "Logging": {
      "RetentionEnabled": true,
      "RetentionDays": 30,
      "RetentionMaxMegabytes": 200
    }
  }
}
