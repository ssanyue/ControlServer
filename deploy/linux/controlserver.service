[Unit]
Description=中控服务版 (ControlServer)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/opt/controlserver
ExecStart=/opt/controlserver/ControlServer.Server

# 专用低权限账户（由 install.sh 创建）
User=controlserver
Group=controlserver

# 进程自愈：崩溃后无条件重启
Restart=always
RestartSec=5

# ── 运行配置 ─────────────────────────────────────────────────
# 下面两行会被 install.sh 按 --port / --data-dir 改写，请勿改动前缀。
Environment=Server__Http__Urls=http://0.0.0.0:8899
Environment=Server__Storage__DataDir=/var/lib/controlserver
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=Server__Startup__AutoOpenBrowser=false

# 自包含发布不需要系统 .NET；此变量仅在改用「依赖框架」发布时才有意义。
Environment=DOTNET_ROOT=/opt/controlserver

# 若改用 <1024 端口，放开下一行即可（无需再手工 setcap）：
#AmbientCapabilities=CAP_NET_BIND_SERVICE

# 优雅停机：先 SIGINT，最长等 30s
KillSignal=SIGINT
TimeoutStopSec=30

SyslogIdentifier=controlserver

# ── 安全加固（不牺牲功能）─────────────────────────────────────
# 注意：数据目录在 /var/lib、程序在 /opt，均不在 ProtectSystem=full 的保护范围内，
# 因此无需额外的 ReadWritePaths。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
